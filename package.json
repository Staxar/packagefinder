{
  "name": "packagefinder",
  "displayName": "Package Finder",
  "description": "A VS Code extension to search for and install npm or yarn packages.",
  "version": "0.0.4",
  "icon": "images/packagefinder.webp",
  "publisher": "Staxar",
  "engines": {
    "vscode": ">=1.80.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Staxar/packagefinder"
  },
  "categories": [
    "Programming Languages",
    "Extension Packs",
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "packagefinder.finder",
        "title": "Search package",
        "category": "Package Finder"
      },
      {
        "command": "packagefinder.selectPackageManager",
        "title": "Select Package Manager",
        "category": "Package Finder"
      },
      {
        "command": "packagefinder.clearWorkSpaceData",
        "title": "Clear WorkSpace Package Manager data",
        "category": "Package Finder"
      }
    ],
    "keybindings": [
      {
        "command": "packagefinder.finder",
        "key": "ctrl+alt+p",
        "mac": "shift+cmd+p"
      },
      {
        "command": "packagefinder.selectPackageManager",
        "key": "ctrl+alt+m",
        "mac": "shift+cmd+m"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "20.x",
    "@types/vscode": ">=1.80.0",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.9.1",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "axios": "^1.13.5"
  }
}
